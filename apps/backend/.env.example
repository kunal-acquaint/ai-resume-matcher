# Copy to .env and adjust. Every value below is also the built-in default.

NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/resume-matcher

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_MS=120000

# Scoring (see project_specification.md §4.3)
SIM_FLOOR=0.15
SIM_CEILING=0.70
SCORE_WEIGHT_SEMANTIC=0.6
SCORE_WEIGHT_COVERAGE=0.4

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173
