# Copy to .env and adjust. Every value below except JWT_SECRET and ADMIN_* is also the built-in default.

NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/resume-matcher

# Auth. JWT_SECRET is REQUIRED (at least 32 random characters). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
LOGIN_RATE_LIMIT=5

# First admin, used only by `npm run seed:admin`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# AI: "stub" (stand-ins, no models needed) or "local" (MiniLM + Ollama)
AI_PROVIDER=stub
# Simulated LLM time for the stand-in skill extractor, so the "extracting skills" state is visible
AI_STUB_DELAY_MS=2000

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_MS=600000

# Scoring (see project_specification.md §5.3 and §5.5); calibrated in milestone 11
SIM_FLOOR=0.25
SIM_CEILING=0.80
SKILL_MATCH_THRESHOLD=0.55
SCORE_WEIGHT_SEMANTIC=0.6
SCORE_WEIGHT_COVERAGE=0.4

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173
