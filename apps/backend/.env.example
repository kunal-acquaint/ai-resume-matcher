# Copy to .env and adjust. Every value below except JWT_SECRET and ADMIN_* is also the built-in default.

NODE_ENV=
PORT=

# Database
MONGODB_URI=

# Auth. JWT_SECRET is REQUIRED (at least 32 random characters). Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=
LOGIN_RATE_LIMIT=

# First admin, used only by `npm run seed:admin`
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI: "stub" (stand-ins, no models needed) or "local" (MiniLM + Ollama)
AI_PROVIDER=
# Embedding model for AI_PROVIDER=local; downloaded once (about 23 MB) into MODEL_CACHE_DIR
EMBEDDING_MODEL=
MODEL_CACHE_DIR=
# Simulated LLM time for the stand-in skill extractor, so the "extracting skills" state is visible
AI_STUB_DELAY_MS=

# Local LLM (Ollama)
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_NUM_CTX=
OLLAMA_TIMEOUT_MS=

# Scoring (see project_specification.md §5.3 and §5.5); calibrated in milestone 11 on a synthetic dataset
SIM_FLOOR=
SIM_CEILING=
SKILL_MATCH_THRESHOLD=
SCORE_WEIGHT_SEMANTIC=
SCORE_WEIGHT_COVERAGE=

# Frontend origin allowed by CORS
CORS_ORIGIN=
